<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Challenge 8</title>
    <link rel="stylesheet" href="/style.css">
</head>
<script src="/js/client.js"></script>

<body>
    <main class="main-container">
        <h1><%= titulo %></h1>
        <p><%= mensaje %></p>

        <section id="topics-container">
            <%- include('partials/topic-list') %>
        </section>

        <section class="create-topic-card">
            <h2>Crear un nuevo tema </h2>
            <form class="topic-form" onsubmit="event.preventDefault(); createTopic()">
                <div class="form-group">
                    <label for="new-title">Titulo:</label>
                    <input type="text" id="new-title" required>
                </div>
                <div class="form-group">
                    <label for="new-description"> Descripcion:</label>
                    <textarea id="new-description" rows="3" required></textarea>
                </div>
                <button type="submit" class="btn">Agregar Tema</button>
            </form>
        </section>
    </main>
</body>
</html>