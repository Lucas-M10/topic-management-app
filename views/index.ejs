<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Challenge 8</title>
    <link rel="stylesheet" href="/style.css">
</head>
<script>
    function ToggleTopicEdit (topicID){
        const viewBlock = document.getElementById (`topic-view-${topicID}`);
        const editBlock = document.getElementById (`topic-edit-${topicID}`);

        if (viewBlock && editBlock ){
            viewBlock.classList.toggle (`is-hidden`);
            editBlock.classList.toggle (`is-hidden`);
        }
    }
</script>

<body>
    <main class="main-container">
        <h1><%= titulo%></h1>
        <p><%= mensaje%></p>

        <% if (topics.length == 0) { %> 
            <p> No hay temas registrados todavia. </p> <% } 

            else { %> 
            <!-- El contenedor padre se abre una sola vez fuera del bucle  -->
            <ul> 
                <% topics.forEach (topic => { %>
                    <!-- El item se repite N veces dentro del bucle -->
                    <li>
                        <div id="topic-view-<%= topic.id %>">
                            <h2><%= topic.title %></h2>
                            <p><%= topic.description %></p>
                            <div class="topic-actions">
                                <strong> Votos: <%= topic.votes %></strong>

                                <!--Boton que nos permite votar por el tema -->
                                <form action = "/topics/<%= topic.id %>/vote" method="POST" class="vote-form" >
                                    <button type="submit" class="btn">Votar </button>
                                </form>

                                <!--Boton que nos permite eliminar el tema-->
                                <form action="/topics/<%= topic.id %>/delete" method = "POST" style="display: inline; margin-left: 5px;">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                                
                                <!--Boton para poder editar el tema-->
                                <button type="button" class="btn btn-update" onclick="ToggleTopicEdit('<%= topic.id %>')" style="margin-left: 5px;">
                                    Editar
                                </button>
                            </div>
                        </div>
                    
                        <div id="topic-edit-<%= topic.id %>" class="is-hidden" style="margin-bottom: 15px;">
                            <form action="/topics/<%= topic.id %>/edit" method="POST" class="topic-form">
                                <div class="form-group">
                                    <label for="title-<%= topic.id %>">Titulo:</label>
                                    <input type="text" id="title-<%= topic.id %>" name="title" value="<%= topic.title %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="desc-<%= topic.id%>">Descripcion:</label>
                                    <textarea id="desc-<%= topic.id %>" name="description" rows="3" required><%= topic.description %></textarea>
                                </div>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <button type="submit" class="btn" >Guardar Cambios</button>
                                    <button type="button" class="btn btn-danger" onclick="ToggleTopicEdit('<%= topic.id %>')">Cancelar</button>
                                </div>
                            </form>
                        </div>

                        <!--El contenedor que tendra los links vinculados a un tema. -->
                        <div class="links-section">
                            <h3>Recursos y Enlaces:</h3>
                            <% if (!topic.links || topic.links.length === 0) { %>
                                <p style="font-size: 0.9em; color: #666;">No hay enlaces agregados aun.</p>
                            <% } else { %>
                                <ul>
                                    <% topic.links.forEach (link => { %>
                                        <li style="margin-bottom: 8px;">
                                            <span><%= link.title%> - <strong>Votos: <%= link.votes %></strong></span>
                                            
                                            <!--Boton para poder votar por los links-->
                                            <form action="/topics/<%= topic.id %>/links/<%= link.id %>/vote" method="POST" style="display: inline; margin-left: 8px;">
                                                <button type="submit" class="btn btn-sm">Vote</button>
                                            </form>

                                            <!--Boton para eliminar los links-->
                                            <form action="/topics/<%=topic.id %>/links/<%= link.id %>/delete" method="POST" style="display: inline; margin-left: 4px;">
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>


                                        </li>
                                    <% }); %>
                                </ul>
                            <% } %>
                            <!-- Formulario para agregar un nuevo enlace al tema actual-->
                            <form action="/topics/<%=topic.id %>/links" method="POST" style="margin-top: 10px;">
                                <input 
                                        type="text"
                                        name="title"
                                        placeholder=" Nuevo Recurso o enlace"
                                        required
                                        style="padding: 4px 8px; font-size: 0.85rem;">
                                <button type="submit" class="btn btn-sm">Agregar Enlace</button>
                            </form>
                        </div>
                    </li>
                <%}); %>
            </ul>
        <% } %>
        <section class="create-topic-card">
            <h2>Crear un nuevo tema </h2>
            <form action="/topics" method="POST" class="topic-form">
                <div class="form-group">
                    <label for=" title">Titulo:</label>
                    <input type="text" id="title" name="title" required>
                </div>
                <div class="form-group"> 
                    <label for="description"> Descripcion:</label>
                    <textarea id="description" name="description" rows="3" required></textarea>
                </div>
                <button type="submit" class="btn">Agregar Tema</button>
            </form> 


        </section>
    </main>
    
    
</body>

</html>