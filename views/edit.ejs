<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width device-width, initial-scale=1.0">
        <title>Editar tema: <%= topic.title%></title>
        <link rel="stylesheet" href="/css/style.css">
    </head>

    <body>
        <main class="container">
            <h1>Editar Tema</h1>

            <!--Formulario que enviara los cambios al backend. -->
            <form action="/topics/<%= topic.id %>/edit" method="POST">
                <div style="margin-bottom: 15px;">
                    <label for="title" style="display: block; font-weight: bold; margin-bottom: 5px;">
                        Titulo: 
                    </label>
                    <input 
                        type="text"
                        id="title"
                        name="title"
                        value="<%= topic.title %>"
                        required
                        style="width: 100%; padding: 8px; box-sizing: border-box;">
                </div>

                <div style="margin-bottom: 15px;">
                    <label for="description" style="display: block; font-weight: bold; margin-bottom: 5px;">
                        Descripcion:  
                    </label>
                    <textarea
                        id="description"
                        name="description"
                        rows="4"
                        required
                        style="width: 100%; padding: 8px; box-sizing: border-box;"
                        > <%= topic.description %></textarea>
                </div>

                <div style="display: flex; gap: 10px; align-items: center;">
                    <button type="submit" class="btn">Guardar cambios</button>
                    <a href="/" style="text-decoration: none; color: #666;">Cancelar</a>
                </div>
            </form>
        </main>
    </body>
</html>